# Moremaid configuration — ~/.config/moremaid/config.toml
#
# This file is optional; every key has a sensible default. Key names are
# stable — symlink it from your dotfiles with confidence. Changes apply the
# next time a window opens.

[font]
# Prose face for documents and the Navigator. iA Writer Quattro S ships with
# Omarchy (ttf-ia-writer) and is a genuine reading typeface.
#body = "iA Writer Quattro S"

# Code face. The bare generic "monospace" is a feature, not a placeholder:
# it resolves through fontconfig to whatever you chose with `omarchy font`.
# Name a family (e.g. "JetBrains Mono") to pin one instead.
#mono = "monospace"

# Base document font size in px, before the system text-scaling-factor
# (`omarchy display text size`) is applied on top.
#size = 16
