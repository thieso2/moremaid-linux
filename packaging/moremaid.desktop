[Desktop Entry]
Type=Application
Name=Moremaid
GenericName=Markdown Reader
Comment=A markdown reader with first-class Mermaid diagram support
Exec=moremaid %f
Icon=moremaid
Terminal=false
Categories=Office;Viewer;
# Offers itself for markdown without grabbing the default — Omarchy already
# ships Omawrite and Obsidian, and stealing the association would be rude (§10).
MimeType=text/markdown;text/x-markdown;
StartupWMClass=org.moremaid.Moremaid
